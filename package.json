{
  "name": "gislaine-duarte",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "generate": "node --env-file-if-exists=.env scripts/generate-pages.mjs",
    "dev": "npm run generate && vite --host 127.0.0.1",
    "build": "npm run generate && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "playwright test",
    "test:unit": "node --test tests/unit/*.test.js",
    "audit": "node --env-file-if-exists=.env scripts/audit-site.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "check": "npm run lint && npm run build && npm run audit"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.0",
    "eslint": "10.11.0",
    "@eslint/js": "10.0.1",
    "globals": "17.12.0",
    "@playwright/test": "^1.58.2",
    "@axe-core/playwright": "^4.11.1",
    "lighthouse": "^13.0.3",
    "sharp": "0.35.4",
    "cheerio": "^1.2.0"
  }
}
