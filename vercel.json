{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/7-receitas-para-ajudar-voce-a-desinflamar", "destination": "/livro-de-receitas", "permanent": true }
  ],
  "functions": {
    "api/nutrition/assistant.js": { "maxDuration": 60 },
    "api/admin/nutrition-assistant.js": { "maxDuration": 60 },
    "api/nutrition/return.js": { "maxDuration": 30 },
    "api/nutrition/index.js": {
      "includeFiles": "{public/fonts,public/images/foods,public/images/teas,public/images/recipes-real,public/images/plates,server/nutrition/fonts}/**",
      "maxDuration": 60
    },
    "api/admin/nutrition.js": {
      "includeFiles": "{public/fonts,public/images/foods,public/images/teas,public/images/recipes-real,public/images/plates,server/nutrition/fonts}/**",
      "maxDuration": 60
    },
    "api/recipes/download.js": {
      "includeFiles": "{public/fonts/**,public/images/foods/**,public/images/teas/**,public/images/recipes-real/**,public/images/recipes/**,public/images/recipes-editorial/**,public/images/glp-recipes/**,public/images/brand-mark.svg,server/nutrition/fonts/**,src/styles/product-guide.css}",
      "maxDuration": 60
    }
  },
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }
  ]
}
