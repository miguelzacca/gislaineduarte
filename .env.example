# Defaults oficiais confirmados estão em src/data/site.js. Preencher apenas para sobrescrever.
# Aceita DDD + número brasileiro ou país + DDD + número.
PUBLIC_WHATSAPP=
PUBLIC_EMAIL=
PUBLIC_INSTAGRAM=
# Previews não devem ser indexados.
PUBLIC_SITE_NOINDEX=false

# Checkout InfinitePay. A conta muda apenas alterando a InfiniteTag.
# URL HTTPS pública do site, sem caminho e sem barra final.
INFINITEPAY_HANDLE=
RECIPES_SITE_URL=https://gislaineduarte.com.br

# Postgres persistente (Prisma Postgres/Vercel, Neon, Supabase ou outro com TLS).
# Use a URL postgres:// ou postgresql://. O projeto utiliza somente DATABASE_URL.
DATABASE_URL=

# Gmail SMTP via Nodemailer. Use senha de app do Google, nunca a senha da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=

# Painel /painel/ (privado, sem link no site). Senha com 16+ caracteres e segredo com 32+.
RECIPES_ADMIN_USERNAME=
RECIPES_ADMIN_PASSWORD=
RECIPES_ADMIN_SESSION_SECRET=

# Sessão da pessoa compradora: 1 a 365 dias; padrão 30.
RECIPES_PRODUCT_SESSION_TTL_DAYS=30
