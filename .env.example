# Defaults oficiais confirmados estão em src/data/site.js. Preencher apenas para sobrescrever.
# Aceita DDD + número brasileiro ou país + DDD + número.
PUBLIC_WHATSAPP=
PUBLIC_EMAIL=
PUBLIC_INSTAGRAM=
# Previews não devem ser indexados.
PUBLIC_SITE_NOINDEX=false

# Produto digital: sem estas variáveis, a produção permanece bloqueada.
# Valores aceitos: locked | mock. O mock é apenas uma demonstração, sem cobrança.
RECIPES_PRODUCT_ACCESS_MODE=locked
RECIPES_PRODUCT_MOCK_CHECKOUT_ENABLED=false
# Gere um segredo aleatório de pelo menos 32 caracteres e defina-o SOMENTE na Vercel.
# Não use PUBLIC_ ou VITE_ neste nome; nunca faça commit do valor real.
RECIPES_PRODUCT_ACCESS_SECRET=
# Válido de 1 a 365 dias; padrão seguro de 30 dias quando omitido.
RECIPES_PRODUCT_SESSION_TTL_DAYS=30
